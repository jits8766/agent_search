# semantic-search API container — pretrained models baked into the image.
# CI syncs the models from S3 into ./pretrained before the build (see deploy
# workflows), then COPY bakes them so runtime needs no S3/EFS. The container
# validates model availability at startup and logs status (see app.py lifespan).
#
# Build context MUST be the auc-semantic-search repo root, with ./pretrained present:
#   API:     docker build -t agent-search -f packages/semantic-search/Dockerfile .
#   Trainer: docker build --target trainer -t agent-search-trainer -f packages/semantic-search/Dockerfile .
#
# Base image: Chainguard Wolfi python (cgr.dev/chainguard/python). Chosen to
# eliminate OS-package CVEs at the source — a Debian/Ubuntu base always ships
# perl, gzip, pam, gnupg, xz, util-linux, etc., each carrying open no-fix
# advisories that no `apt-get upgrade` can clear. Wolfi is a minimal,
# continuously-patched (0-known-CVE) distro. Build uses `pip` (NOT uv) so the
# uv Rust binary — and its cargo-crate advisories (quick-xml/rsa/memmap2/
# anyhow/proc-macro-error2) — never enter the image. TLS cert is generated by
# tls_entrypoint.py via the cryptography lib, so no shell / openssl CLI needed.
#
# The `-dev` variant is used as the runtime base (not the ultra-minimal image)
# because torch's CPU wheel needs a system libstdc++, which the minimal image
# omits; the `-dev` image is still Chainguard-patched to 0-known-CVE.
FROM cgr.dev/chainguard/python:latest-dev AS base

USER root
WORKDIR /app

# Isolated venv so the interpreter's own site-packages stay untouched.
RUN python -m venv /app/venv
ENV PATH="/app/venv/bin:$PATH" \
    PYTHONPATH=/app \
    PYTHONDONTWRITEBYTECODE=1

COPY packages/llm-core/llm_core/ llm_core/
COPY packages/llm-core/requirements.txt llm_core_requirements.txt
COPY packages/semantic-search/semantic_search/ semantic_search/
COPY packages/semantic-search/requirements.txt semantic_search_requirements.txt
COPY packages/semantic-search/tls_entrypoint.py tls_entrypoint.py
COPY find_api_params.json find_api_params.json

# Step 1: CPU-only torch from the PyTorch wheel index — avoids the default PyPI
# CUDA wheel which pulls nvidia-cudnn / nccl / triton (~GB). Never install torch
# from requirements.txt (PyPI metadata declares those GPU deps on Linux).
RUN pip install --no-cache-dir \
    --index-url https://download.pytorch.org/whl/cpu \
    torch==2.13.0

# Step 2: all other deps from PyPI. requirements.txt must NOT list torch or
# training-only HF stack (accelerate/evaluate/datasets) — those re-resolve
# CUDA torch from PyPI. torch==2.13.0+cpu already satisfies torch==2.13.0.
# setuptools>=83.0.0 (CVE-2026-59890). transformers==5.5.0 (CVE-2026-5241).
RUN pip install --no-cache-dir \
    -r semantic_search_requirements.txt \
    -r llm_core_requirements.txt \
    pyyaml==6.0.2 fastapi==0.138.0 uvicorn==0.49.0 pydantic==2.13.4 \
    "python-multipart>=0.0.31" "setuptools>=83.0.0"

# Pretrained models (nomic-embed, BM42 sparse, semantic_router, ngram_pregate)
# baked into the image. CI syncs from S3 excluding knowledgator/ (GLiNER) and spacy/.
# base.yaml resolves ${LOCAL_PRETRAINED_DIR:-/app/pretrained} to this baked path.
# HF_HUB_OFFLINE blocks any HuggingFace network download regardless.
COPY pretrained/ /app/pretrained/
ENV LOCAL_PRETRAINED_DIR=/app/pretrained \
    HF_HUB_OFFLINE=1 \
    QDRANT_HOST=localhost \
    CLICKHOUSE_HOST=localhost

# Runtime-writable dirs (feedback sink + ephemeral TLS material), owned by the
# non-root runtime user so the shell-less container can write to them.
RUN mkdir -p /app/output /app/tls && chown -R nonroot:nonroot /app

# ---------------------------------------------------------------------------
# trainer stage — sklearn already installed via requirements.txt.
#   docker build --target trainer -t agent-search-trainer -f packages/semantic-search/Dockerfile .
# ---------------------------------------------------------------------------
FROM base AS trainer
USER nonroot
ENTRYPOINT ["python", "-m", "semantic_search.qi.training.head_trainer"]
CMD ["--golden-seeds", "semantic_search/config/golden_seeds.yaml", "--random-search", "--random-search-trials", "20", "--max-epochs", "5000"]

# ---------------------------------------------------------------------------
# api stage — production server (default target; must remain last).
# ---------------------------------------------------------------------------
FROM base AS api
EXPOSE 8085
USER nonroot
ENTRYPOINT ["python", "/app/tls_entrypoint.py"]
